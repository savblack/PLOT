# pnpm replaced npm here on 2026-09-15, so that every git worktree shares one
# copy of node_modules instead of paying ~1GB each. See docs/ops/package-manager.md.

# Keep the flat, npm-style node_modules layout. This is NOT optional:
#   - apps/mobile/metro.config.js sets disableHierarchicalLookup and resolves
#     only <app>/node_modules and <root>/node_modules, which assumes hoisting.
#   - scripts/check-expo-sdk-deps.mjs reads <root>/node_modules/expo/ directly.
# pnpm's default (isolated/symlinked) layout would break both. Hoisting costs us
# nothing: the disk saving comes from the global store + hardlinks, not the layout.
node-linker=hoisted

# The mobile workspace (react-native 0.86.3) pins react 19.2.3 while the web app
# uses react ^19.2.8. npm needed legacy-peer-deps=true to accept the mixed tree;
# this is the pnpm equivalent — resolve and warn rather than fail the install.
strict-peer-dependencies=false

# The internal @plot/core, @plot/ui deps are declared as "*" (not "workspace:*"),
# which npm resolved to the local workspace but pnpm sends to the registry, where
# they 404. This restores npm's behaviour and leaves every package.json untouched,
# so reverting to npm stays a one-line change rather than an edit to six files.
link-workspace-packages=true
