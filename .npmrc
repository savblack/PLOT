# The mobile workspace (react-native 0.85.3) pins react 19.2.3 while the web app
# uses react ^19.2.7; npm's peer-dep resolver rejects the mixed tree without this.
# The workspace still hoists a single react to the root and nests where versions
# differ. (plot-mobile's own CI already used --legacy-peer-deps for the same reason.)
legacy-peer-deps=true
