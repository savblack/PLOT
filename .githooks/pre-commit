#!/usr/bin/env bash
#
# Blocks a commit if the staged changes contain secret-shaped strings.
# Zero dependencies, runs locally before every commit. The pattern list lives
# in scripts/scan-secrets.sh, shared with the CI backstop (ci.yml) that
# catches this for clones that never ran the `git config` line below.
#
# If it ever flags something that is genuinely NOT a secret, bypass with:
#   git commit --no-verify
#
# Enable once per clone with:  git config core.hooksPath .githooks

repo_root=$(git rev-parse --show-toplevel)
if ! "$repo_root/scripts/scan-secrets.sh" --cached; then
  echo "" >&2
  echo "COMMIT BLOCKED: possible secret in staged changes (see above)." >&2
  exit 1
fi

exit 0
