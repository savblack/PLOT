{
  "name": "plot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @plot/web run dev",
    "dev:website": "cd apps/website && wrangler pages dev . --port 5202",
    "build": "pnpm --filter @plot/web run build",
    "preview": "pnpm --filter @plot/web run preview",
    "lint": "eslint .",
    "check": "pnpm run lint && pnpm run build",
    "test:unit": "pnpm --filter @plot/web run test:unit && pnpm --filter @plot/core run test:unit",
    "test:smoke": "pnpm --filter @plot/web run test:smoke",
    "test:website": "node --test apps/website/functions/_lib/*.test.js",
    "test:marketing": "node --test marketing/tests/*.test.mjs",
  "test:workers": "node --test apps/web/workers/*/test/*.test.mjs",
    "footer": "node scripts/build-footer.mjs",
    "footer:check": "node scripts/build-footer.mjs --check",
  "skills": "node scripts/build-agent-skills.mjs",
  "skills:check": "node scripts/build-agent-skills.mjs --check",
    "tokens:build": "node scripts/build-tokens.mjs --write",
    "tokens:check": "node scripts/build-tokens.mjs --check",
    "tokens:marketing": "node scripts/check-marketing-tokens.mjs",
    "colors:check": "node scripts/check-color-literals.mjs",
    "storybook:website": "pnpm --filter @plot/website-storybook run storybook",
    "storybook:web": "pnpm --filter @plot/web run storybook",
    "storybook:mobile": "pnpm --filter @plot/mobile run storybook",
    "storybook:mobile:web": "pnpm --filter @plot/mobile run storybook:web",
    "storybook:web:deploy": "bash scripts/deploy-storybook.sh apps/web plot-storybook-web-app",
    "storybook:website:deploy": "bash scripts/deploy-storybook.sh apps/website plot-storybook-website",
    "storybook:mobile:deploy": "bash scripts/deploy-storybook.sh apps/mobile plot-storybook-mobile",
    "emails:check": "node scripts/push-auth-emails.mjs --check",
    "migrations:check": "node scripts/check-migration-redefinitions.mjs",
    "copy:check": "node scripts/check-hardcoded-copy.mjs",
    "core:check": "node scripts/check-core-imports.mjs",
    "mobile:tabs": "node scripts/check-mobile-tabs.mjs",
    "mobile:deps": "node scripts/check-expo-sdk-deps.mjs",
    "edge:check": "./scripts/check-edge-types.sh",
    "gen:db-types": "supabase gen types typescript --project-id mkegtssedjyqldysvzga --schema public > supabase/functions/_shared/database.types.ts",
    "db:write-paths": "node scripts/check-db-write-paths.mjs",
    "db:block-clause": "node scripts/check-block-clause.mjs",
    "db:migration-test": "bash scripts/db-migration-test.sh",
    "db:function-diff": "bash scripts/db-function-diff.sh",
    "db:restore-drill": "bash scripts/db-restore-drill.sh",
    "supabase:staging": "node scripts/supabase-staging.mjs",
    "staging:session": "node scripts/create-staging-test-session.mjs",
    "staging:private-notes-test": "bash scripts/staging-sql.sh scripts/staging-private-notes-test.sql",
    "staging:block-test": "bash scripts/staging-sql.sh scripts/staging-block-test.sql",
    "staging:premium-flag-test": "bash scripts/staging-sql.sh scripts/staging-premium-flag-test.sql",
    "staging:pgss-guard-test": "bash scripts/staging-sql.sh scripts/staging-pgss-guard-test.sql",
    "mkt:plan": "node marketing/planner/plan.mjs",
    "mkt:guides": "node marketing/planner/guides.mjs",
    "mkt:copy:pull": "node marketing/copy/pull.mjs",
    "mkt:copy:save": "node marketing/copy/save.mjs",
    "mkt:generate": "node marketing/generate/generate.mjs",
    "mkt:schedule": "node marketing/publish/schedule.mjs",
    "mkt:reconcile": "node marketing/publish/reconcile.mjs",
    "mkt:report": "node marketing/metrics/report.mjs",
    "mkt:newsletter": "node marketing/newsletter/send-digest.mjs",
    "mkt:snapshot": "node marketing/snapshot/write-snapshot.mjs",
    "mkt:manual": "node marketing/manual/build.mjs",
    "mkt:manual:media": "node marketing/manual/media.mjs",
    "mkt:manual:publish": "node marketing/manual/publish.mjs",
    "mkt:preview": "node marketing/preview/build-preview.mjs",
    "mkt:backfill": "node scripts/seed-marketing-backfill.mjs",
    "staging:broadcast-test": "bash scripts/staging-sql.sh scripts/staging-broadcast-test.sql",
    "test:guide": "python3 -m unittest discover -s scripts/guide -p \"test_*.py\""
  },
  "dependencies": {
    "@plot/core": "*",
    "@supabase/supabase-js": "^2.116.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "typescript-eslint": "^8.70.0"
  },
  "packageManager": "pnpm@10.6.3"
}
