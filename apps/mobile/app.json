{
  "expo": {
    "name": "plot",
    "slug": "plot",
    "scheme": "plot",
    "version": "0.10.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "tv.theplot.app",
      "usesAppleSignIn": true,
      "supportsTablet": false,
      "associatedDomains": [
        "applinks:app.theplot.tv"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "tv.theplot.app",
      "adaptiveIcon": {
        "backgroundColor": "#292924",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "app.theplot.tv",
              "pathPrefix": "/save"
            },
            {
              "scheme": "https",
              "host": "app.theplot.tv",
              "pathPrefix": "/list"
            },
            {
              "scheme": "https",
              "host": "app.theplot.tv",
              "pathPrefix": "/u"
            },
            {
              "scheme": "https",
              "host": "app.theplot.tv",
              "pathPrefix": "/join-list"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-status-bar",
      "expo-notifications",
      "expo-secure-store",
      "expo-apple-authentication",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Plot to choose a profile photo from your library."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Plot to save share cards to your photos.",
          "savePhotosPermission": "Allow Plot to save share cards to your photos."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "af5eb12a-a0c5-41b0-9d14-5bef0b2279ab"
      }
    }
  }
}
