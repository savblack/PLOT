# Mobile (Expo) build-time env — the same values as the web app's Supabase/TMDB
# config. Copy this file to apps/mobile/.env and fill in the values (they're in
# your main checkout's root .env). EXPO_PUBLIC_* vars are inlined into the JS
# bundle at prebuild / build / `expo start` time.
#
# For local Xcode / `npx expo run:ios` builds, a local apps/mobile/.env is read.
# For EAS cloud builds, set these as EAS environment variables instead:
#   eas env:create --name EXPO_PUBLIC_SUPABASE_URL --value "…" --environment production
# (repeat per variable, per environment).

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_TMDB_PROXY_URL=
EXPO_PUBLIC_TRAKT_CLIENT_ID=
# Same value as the web app's VITE_TURNSTILE_SITE_KEY. Supabase Auth enforces
# captcha protection on all clients, so this is required for signup/login to work.
EXPO_PUBLIC_TURNSTILE_SITE_KEY=

# Product analytics. Same PostHog project as the web app (VITE_PUBLIC_POSTHOG_
# PROJECT_TOKEN) so both apps report into one funnel. Leave blank to disable —
# lib/analytics.ts then makes every track() a silent no-op, which is what you
# want in dev and CI.
EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN=
# Optional. Defaults to https://a.theplot.tv, the same Cloudflare reverse proxy
# every web surface uses. Mobile used to talk to PostHog directly on the
# grounds that a native app can't be ad-blocked; that holds for browser
# extensions but not for DNS-level blockers, and one shared host means the
# ingest endpoint moves in one place rather than five.
EXPO_PUBLIC_POSTHOG_HOST=
# Native has no hostname to allowlist, so analytics is off whenever __DEV__ is
# true. Set to 1 to report from a dev build when you are deliberately testing
# analytics. Mirrors VITE_PUBLIC_POSTHOG_FORCE on web.
EXPO_PUBLIC_POSTHOG_FORCE=

# Optional. Set to "true" once the Google OAuth client exists and the provider
# is enabled in Supabase — see lib/launchFeatures.ts.
EXPO_PUBLIC_SHOW_GOOGLE_LOGIN=
# Optional. Set to "true" only after Apple and Supabase are configured and the
# native flow has passed staging device testing — see lib/launchFeatures.ts.
EXPO_PUBLIC_SHOW_APPLE_LOGIN=
