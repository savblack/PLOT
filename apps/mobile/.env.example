# Mobile (Expo) build-time env — the same values as the web app's Supabase/TMDB
# config. Copy this file to apps/mobile/.env and fill in the values (they're in
# your main checkout's root .env). EXPO_PUBLIC_* vars are inlined into the JS
# bundle at prebuild / build / `expo start` time.
#
# For local Xcode / `npx expo run:ios` builds, a local apps/mobile/.env is read.
# For EAS cloud builds, set these as EAS environment variables instead:
#   eas env:create --name EXPO_PUBLIC_SUPABASE_URL --value "…" --environment production
# (repeat per variable, per environment).

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_TMDB_PROXY_URL=
EXPO_PUBLIC_TRAKT_CLIENT_ID=
# Same value as the web app's VITE_TURNSTILE_SITE_KEY. Supabase Auth enforces
# captcha protection on all clients, so this is required for signup/login to work.
EXPO_PUBLIC_TURNSTILE_SITE_KEY=
