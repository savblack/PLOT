# Cloudflare Pages headers — the security headers previously set in
# apps/web/vercel.json. Vite copies this file verbatim into dist/, where Pages
# reads it. Keep the CSP in sync with any new external hosts the app talks to.
#
# Content-Security-Policy is NOT set here — it's built per-request in
# functions/_middleware.js so script-src can use a fresh nonce instead of
# 'unsafe-inline'. Update the allow-list there, not here.
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=()

/
  Link: </llms.txt>; rel="describedby"; type="text/plain"

# Hashed build output and fonts never change content under a given URL — cache
# them for a year. Images may be replaced in place, so a shorter, revalidated
# TTL is safer there.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/website-images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# iOS universal links file must be served as JSON.
/.well-known/apple-app-site-association
  Content-Type: application/json
