# Hashed build output and fonts never change content under a given URL — cache
# them for a year. Images may be replaced in place, so a shorter, revalidated
# TTL is safer there.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# The boot scripts (startup guard, theme pre-paint, public-page analytics) have
# stable names, so a change cannot bust itself the way a hashed bundle does.
# Keep the window short: the theme list changes when a palette ships.
/boot/*
  Cache-Control: public, max-age=300, must-revalidate

/website-images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# iOS universal links file must be served as JSON.
/.well-known/apple-app-site-association
  Content-Type: application/json

# Email clients fetch this wordmark by URL. Pin the type.
/logo-email.png
  Content-Type: image/png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Email social marks. Named files only, so a missing path under /email/
# still falls through as HTML instead of being labeled image/png.
/email/icon-instagram.png
  Content-Type: image/png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/email/icon-threads.png
  Content-Type: image/png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/email/icon-x.png
  Content-Type: image/png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# These folders skip the Pages Functions (since 2026-11-13 everything but the
# Function routes in _routes.json does), because every Function call counts
# toward the account's daily Workers request allowance, which ran out on
# 2026-11-11. This app has no 404.html, so Pages answers a MISSING path here
# with index.html. The per-host app-csp block above gives that page the full
# app policy; the lock-down policy here is joined to it, so such a page in an
# asset folder is inert rather than a working copy of the app. It does
# not affect the real files: a browser ignores a CSP header on an image,
# font, stylesheet or (non-worker) script it loads into a page.
/assets/*
  Content-Security-Policy: default-src 'none'; frame-ancestors 'none'; sandbox

/fonts/*
  Content-Security-Policy: default-src 'none'; frame-ancestors 'none'; sandbox

/boot/*
  Content-Security-Policy: default-src 'none'; frame-ancestors 'none'; sandbox

/ds/*
  Content-Security-Policy: default-src 'none'; frame-ancestors 'none'; sandbox

/email/*
  Content-Security-Policy: default-src 'none'; frame-ancestors 'none'; sandbox

/import-logos/*
  Content-Security-Policy: default-src 'none'; frame-ancestors 'none'; sandbox

/website-images/*
  Content-Security-Policy: default-src 'none'; frame-ancestors 'none'; sandbox
