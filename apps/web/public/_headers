# Cloudflare Pages headers — the security headers previously set in
# apps/web/vercel.json. Vite copies this file verbatim into dist/, where Pages
# reads it. Keep the CSP in sync with any new external hosts the app talks to.
#
# Content-Security-Policy is NOT set here (except the lock-down on the asset
# folders at the bottom) — it's set in functions/_middleware.js
# so it also covers the server-rendered Function routes, which _headers does not
# reach. Update the allow-list there, not here.
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=()

/
  Link: </llms.txt>; rel="describedby"; type="text/plain"

# Hashed build output and fonts never change content under a given URL — cache
# them for a year. Images may be replaced in place, so a shorter, revalidated
# TTL is safer there.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# The boot scripts (startup guard, theme pre-paint, public-page analytics) have
# stable names, so a change cannot bust itself the way a hashed bundle does.
# Keep the window short: the theme list changes when a palette ships.
/boot/*
  Cache-Control: public, max-age=300, must-revalidate

/website-images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# iOS universal links file must be served as JSON.
/.well-known/apple-app-site-association
  Content-Type: application/json

# Email clients fetch this wordmark by URL. Pin the type.
/logo-email.png
  Content-Type: image/png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Email social marks. Named files only, so a missing path under /email/
# still falls through as HTML instead of being labeled image/png.
/email/icon-instagram.png
  Content-Type: image/png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/email/icon-threads.png
  Content-Type: image/png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/email/icon-x.png
  Content-Type: image/png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# These folders skip the Pages Functions (see _routes.json next to this file),
# because every Function call counts toward the account's daily Workers
# request allowance, and running the middleware on every image, font and
# script ran that allowance out on 2026-11-11. The middleware only touches
# HTML, so real files here lose nothing. But this app has no 404.html, so
# Pages answers a MISSING path here with index.html, and without the
# middleware that page would arrive with no Content-Security-Policy. A
# lock-down policy on these folders makes such a page inert instead. It does
# not affect the real files: a browser ignores a CSP header on an image,
# font, stylesheet or (non-worker) script it loads into a page.
/assets/*
  Content-Security-Policy: default-src 'none'; frame-ancestors 'none'; sandbox

/fonts/*
  Content-Security-Policy: default-src 'none'; frame-ancestors 'none'; sandbox

/boot/*
  Content-Security-Policy: default-src 'none'; frame-ancestors 'none'; sandbox

/ds/*
  Content-Security-Policy: default-src 'none'; frame-ancestors 'none'; sandbox

/email/*
  Content-Security-Policy: default-src 'none'; frame-ancestors 'none'; sandbox

/import-logos/*
  Content-Security-Policy: default-src 'none'; frame-ancestors 'none'; sandbox

/website-images/*
  Content-Security-Policy: default-src 'none'; frame-ancestors 'none'; sandbox
