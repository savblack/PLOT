{
  "name": "@plot/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:smoke": "pnpm run build && playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build-storybook:stats": "storybook build --stats-json",
    "test-storybook": "vitest run --project=storybook",
    "chromatic": "chromatic --storybook-build-dir=storybook-static --storybook-base-dir=apps/web --only-changed --exit-zero-on-changes --auto-accept-changes main"
  },
  "dependencies": {
    "@plot/core": "*",
    "@plot/ui": "*",
    "@supabase/supabase-js": "^2.117.3",
    "html-to-image": "1.11.13",
    "posthog-js": "^1.438.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@playwright/test": "^1.64.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.3",
    "storybook": "^10.6.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}
