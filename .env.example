VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_TMDB_PROXY_URL=https://your-project-ref.supabase.co/functions/v1/tmdb-proxy
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional. Defaults to window.location.origin in the web app.
# Set this when auth/provider callbacks need a stable deployed URL or native deep-link base.
VITE_AUTH_REDIRECT_BASE_URL=https://app.theplot.tv

# Cloudflare Turnstile site key (bot protection on auth forms). Free, $0/mo.
# Optional locally: when unset the CAPTCHA widget does not render. Required in
# production once Turnstile is enabled in Supabase Auth → Bot & Abuse Protection
# (the matching secret key lives in the Supabase dashboard, not here).
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key

# Local scripts only. Do not prefix with VITE_ or expose in the browser.
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
TMDB_API_KEY=your_tmdb_api_key
# Newsletter featured-title ratings (Rotten Tomatoes / Metacritic via OMDb).
# Free tier: https://www.omdbapi.com/apikey.aspx — optional; ratings degrade gracefully if unset.
OMDB_API_KEY=your_omdb_api_key
PLEX_TOKEN_SECRET=your_long_random_secret_for_server_side_token_encryption

# Platform Top 10 charts (scripts/sync-*-top10.mjs; in CI these are GitHub secrets/vars).
# Netflix uses its free public feed (no key). Prime/Max/Apple use the Streaming
# Availability API via RapidAPI — free tier, 100 req/day. CHART_REGIONS is an
# optional comma-separated ISO2 list (default: us,gb,au,ca,de,fr,es,it,br,mx,in,jp).
RAPIDAPI_KEY=your_rapidapi_key
# CHART_REGIONS=us,gb,au

# Marketing automation (marketing/ scripts; in CI these are GitHub secrets).
# SUPABASE_URL falls back to VITE_SUPABASE_URL; SUPABASE_SERVICE_ROLE_KEY to SUPABASE_SERVICE_KEY.
ANTHROPIC_API_KEY=your_anthropic_api_key
RESEND_API_KEY=your_resend_api_key
MARKETING_ADMIN_EMAIL=you@example.com
BUFFER_API_KEY=your_buffer_personal_api_key
# Optional: skip Buffer channel discovery / pin the X channel
# BUFFER_CHANNEL_ID=...
# One-time token bootstrap only (marketing/setup/exchange-tokens.mjs):
# IG_APP_ID=... IG_APP_SECRET=... TH_APP_ID=... TH_APP_SECRET=...
