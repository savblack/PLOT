# PLOT Staging (preview project) — local dev has no backend of its own, so it
# borrows a real Supabase project, and this keeps it off real user data (see
# never-modify-real-user-accounts). The anon key below is safe to commit: it's
# meant to be public, gated by RLS, same as what ships in every browser bundle.
# Only point these at PLOT Production deliberately, never for routine dev.
VITE_SUPABASE_URL=https://uzrhfivnhdcfieuaxzip.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InV6cmhmaXZuaGRjZmlldWF4emlwIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODQ2MjYyMzcsImV4cCI6MjEwMDIwMjIzN30.0jE5NiEmwLUHFzsXQBxQDcxhlj0BQXRayTP_8syVT58
# This MUST be the tmdb-proxy Cloudflare Worker URL, NOT the Supabase Edge
# Function directly (apps/web/workers/tmdb-proxy) — the Edge Function rejects
# every request with 403 "Proxy access required" unless it carries the
# X-PLOT-TMDB-Proxy-Secret header, which only the Worker adds. Pointing this
# straight at *.supabase.co/functions/v1/tmdb-proxy silently breaks Discover,
# Releases, Search, and title details app-wide (see incident 2026-07-28).
VITE_TMDB_PROXY_URL=https://tmdb-proxy.<your-workers-subdomain>.workers.dev
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
# Managed reverse proxy (PostHog org settings → Managed reverse proxy), so
# ingestion isn't blocked by ad blockers. Falls back to the direct PostHog
# host if unset. Paired with a hardcoded ui_host in apps/web/src/main.jsx.
VITE_PUBLIC_POSTHOG_HOST=https://a.theplot.tv
# Analytics only runs on theplot.tv / app.theplot.tv (see
# apps/web/src/utils/analyticsHost.js). Localhost, *.pages.dev and CI send
# nothing, so dev clicking-around stays out of the one production project.
# Set this to 1 only when you are deliberately testing analytics locally.
# Never set it in CI or in the Cloudflare build env.
VITE_PUBLIC_POSTHOG_FORCE=

# Optional. Defaults to window.location.origin in the web app.
# Set this when auth/provider callbacks need a stable deployed URL or native deep-link base.
VITE_AUTH_REDIRECT_BASE_URL=https://app.theplot.tv

# Cloudflare Turnstile site key (bot protection on auth forms). Free, $0/mo.
# Optional locally: when unset the CAPTCHA widget does not render. Required in
# production once Turnstile is enabled in Supabase Auth → Bot & Abuse Protection
# (the matching secret key lives in the Supabase dashboard, not here).
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key

# Server-only. A JustWatch Content Partner token enables verified provider
# title links and rent/buy prices. Never prefix this with VITE_. Without it,
# PLOT still shows region-specific TMDB availability and opens the exact
# JustWatch title page, never a provider search result.
JUSTWATCH_PARTNER_TOKEN=your_justwatch_partner_token

# Stripe one-time tip jar Payment Link (Settings → Support PLOT).
# Optional — the tip row is hidden when unset.
# VITE_TIP_JAR_URL=https://buy.stripe.com/your_payment_link

# Share-link OG cards. When set, og:image points at the Cloudflare Worker
# (apps/web/workers/og) instead of the Vercel /api/og function — the render was
# moved off Vercel to avoid the Hobby CPU/origin caps. Set BOTH to the same
# Worker URL (server functions read OG_BASE_URL; the client build reads the
# VITE_ one). Unset both to roll back to /api/og. See the worker README.
# OG_BASE_URL=https://plot-og.your-subdomain.workers.dev
# VITE_OG_BASE_URL=https://plot-og.your-subdomain.workers.dev

# Local scripts only. Do not prefix with VITE_ or expose in the browser.
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
TMDB_API_KEY=your_tmdb_api_key
# Newsletter featured-title ratings (Rotten Tomatoes / Metacritic via OMDb).
# Free tier: https://www.omdbapi.com/apikey.aspx — optional; ratings degrade gracefully if unset.
OMDB_API_KEY=your_omdb_api_key
PLEX_TOKEN_SECRET=your_long_random_secret_for_server_side_token_encryption

# Platform Top 10 charts (scripts/sync-*-top10.mjs; in CI these are GitHub secrets/vars).
# Netflix uses its free public feed (no key). Prime/Max/Apple use the Streaming
# Availability API via RapidAPI — free tier, 100 req/day. CHART_REGIONS is an
# optional comma-separated ISO2 list (default: us,gb,au,ca,de,fr,es,it,br,mx,in,jp).
RAPIDAPI_KEY=your_rapidapi_key
# CHART_REGIONS=us,gb,au

# Marketing automation (marketing/ scripts; in CI these are GitHub secrets).
# SUPABASE_URL falls back to VITE_SUPABASE_URL, which now defaults to Staging
# above — set this explicitly to Production so marketing/maintenance scripts
# stay decoupled from the local-dev target. SUPABASE_SERVICE_ROLE_KEY falls
# back to SUPABASE_SERVICE_KEY.
SUPABASE_URL=https://mkegtssedjyqldysvzga.supabase.co
ANTHROPIC_API_KEY=your_anthropic_api_key
RESEND_API_KEY=your_resend_api_key
MARKETING_ADMIN_EMAIL=you@example.com
# Brevo contact sync (marketing/setup/brevo-sync.mjs). Generate at Brevo ->
# SMTP & API settings -> API keys. BREVO_LIST_ID / BREVO_MARKETING_LIST_ID /
# BREVO_WAITLIST_LIST_ID are Supabase Edge Function secrets, not local env —
# the sync script prints them on first run once it creates the lists.
BREVO_API_KEY=your_brevo_api_key
BUFFER_API_KEY=your_buffer_personal_api_key
# Optional: skip Buffer channel discovery / pin the X channel
# BUFFER_CHANNEL_ID=...
